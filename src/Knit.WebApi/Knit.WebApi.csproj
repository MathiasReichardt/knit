<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Knit.WebApi</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <SpaSourceDir>$(MSBuildThisFileDirectory)..\Knit.Web</SpaSourceDir>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.9" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Knit.Core\Knit.Core.csproj" />
    <ProjectReference Include="..\Knit.Data\Knit.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <SpaInput Include="$(SpaSourceDir)\src\**\*.ts;$(SpaSourceDir)\src\**\*.tsx;$(SpaSourceDir)\src\**\*.css"
              Exclude="$(SpaSourceDir)\src\routeTree.gen.ts" />
    <SpaInput Include="$(SpaSourceDir)\package.json;$(SpaSourceDir)\vite.config.ts;$(SpaSourceDir)\tsconfig.json;$(SpaSourceDir)\index.html" />
  </ItemGroup>
  <ItemGroup>
    <!-- The IDE fast up-to-date check only watches known project items, not
         custom-target inputs. Without this, editing only SPA sources (e.g.
         agent edits) is judged up-to-date and Run skips MSBuild entirely, so
         BuildSpa never re-embeds and the Host serves a stale SPA. -->
    <UpToDateCheckInput Include="@(SpaInput)" />
    <UpToDateCheckBuilt Include="$(SpaSourceDir)\dist\index.html" />
  </ItemGroup>
  <Target Name="BuildSpa"
          Inputs="@(SpaInput)"
          Outputs="$(SpaSourceDir)\dist\index.html"
          Condition="'$(SkipNpmBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm ci"
          WorkingDirectory="$(SpaSourceDir)"
          Condition="!Exists('$(SpaSourceDir)\node_modules')" />
    <Exec Command="npm run build"
          WorkingDirectory="$(SpaSourceDir)" />
  </Target>
  <!--
    EmbeddedResource items must be added AFTER BuildSpa runs (Vite
    emits content-hashed filenames) but BEFORE
    _CalculateEmbeddedFilesManifestInputs from the FileProviders.Embedded
    package — that target decides whether to embed the manifest XML
    resource based on @(EmbeddedResource) being non-empty *at that
    moment*. Adding items later regenerates the XML on disk but skips
    embedding it, so ManifestEmbeddedFileProvider throws at runtime
    ("Could not load the embedded file manifest …").
    No Exists(dist) condition here: a target's condition is evaluated before
    its DependsOnTargets, so on a fresh clone it would skip BuildSpa itself.
  -->
  <Target Name="CollectSpaEmbeddedResources"
          DependsOnTargets="BuildSpa"
          BeforeTargets="_CalculateEmbeddedFilesManifestInputs;AssignTargetPaths">
    <ItemGroup>
      <_SpaDistFile Include="$(SpaSourceDir)\dist\**\*.*" />
    </ItemGroup>
    <ItemGroup>
      <!-- `/`, not `\`: MSBuild leaves metadata untouched on Unix, so a
           backslash ends up inside the manifest's file name and the
           `wwwroot` folder doesn't exist there. -->
      <EmbeddedResource Include="@(_SpaDistFile)">
        <Link>wwwroot/%(_SpaDistFile.RecursiveDir)%(_SpaDistFile.Filename)%(_SpaDistFile.Extension)</Link>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
  <!-- node_modules stays: it is a dependency cache like NuGet's, not build output. -->
  <Target Name="CleanSpa" AfterTargets="Clean">
    <RemoveDir Directories="$(SpaSourceDir)\dist" />
    <Delete Files="$(SpaSourceDir)\src\routeTree.gen.ts" />
  </Target>
</Project>
